<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>etab-cli</AssemblyName>
    <Version>0.1.0</Version>
    <SidecarVersion>$(Version)</SidecarVersion>
    <SidecarBuildId Condition="'$(SidecarBuildId)' == '' and '$(Configuration)' == 'Debug'">0.1.0+gdev</SidecarBuildId>
    <Description>A command-line tool for automating ETABS operations, designed to be called from a Rust Tauri backend application.</Description>

    <!-- Enable Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Suppress specific warnings -->
    <NoWarn>CA1852</NoWarn>
    <NoWarn>IDE0073</NoWarn>
    <NoWarn>IDE0011</NoWarn>
    
    <!-- Publishing Options for Tauri Integration -->
    <!-- ⚠️ IMPORTANT: NativeAOT might not work with COM Interop (ETABS API) -->
    <!-- If you get COM errors, disable PublishAot and use PublishTrimmed instead -->
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Optimization -->
    <OptimizationPreference>Speed</OptimizationPreference>

    <!-- Faster startup for single-file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Keep debugging support for development -->
    <DebuggerSupport Condition="'$(Configuration)' == 'Debug'">true</DebuggerSupport>
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>

    <!-- Event Source Support -->
    <EventSourceSupport>true</EventSourceSupport>

   
    
  </PropertyGroup>

  <Target Name="RequireReleaseSidecarBuildId"
          BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(Configuration)' == 'Release' and '$(SidecarBuildId)' == ''">
    <Error Text="Release builds require -p:SidecarBuildId=&lt;immutable-build-id&gt;." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SidecarVersion" Value="$(SidecarVersion)" />
    <AssemblyMetadata Include="SidecarBuildId" Value="$(SidecarBuildId)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EtabSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Snappier" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\RunAnalysis\" />
    <Folder Include="Features\UnlockModel\" />
    <Folder Include="Features\UnlockModel\" />
  </ItemGroup>

</Project>
