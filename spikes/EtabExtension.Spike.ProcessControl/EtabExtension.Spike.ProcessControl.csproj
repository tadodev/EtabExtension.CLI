<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY SPIKE — NOT PRODUCTION, NOT FOR MERGE.

    Deliberately NOT added to EtabExtension.CLI.slnx, and it does NOT reference the
    production project. Two consequences, both intended:
      * the shipped-project build and the certification build are completely unaffected;
      * the spike cannot accidentally inherit any window-suppression code, so the
        forbidden out-of-process ShowWindow(SW_HIDE) actuator cannot reach it.

    It references only EtabSharp, for the same ETABSv1 interop the certified path uses.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>etabs-process-control-spike</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);IDE0011;CA1848;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EtabSharp" />
  </ItemGroup>

</Project>
